CORE_FLAGS := -DVK_ENABLE_BETA_EXTENSIONS \
	-Isrc -I$(LRC_DIR)/include -I. \
	-isystem $(EXT_DIR)/spirv-headers/include \
	-isystem $(EXT_DIR)/vulkan-headers/include -isystem $(EXT_DIR)/libusb/libusb
# A log or string format that does not match its arguments fails the build
CORE_CXXFLAGS := -Wno-invalid-offsetof -Werror=format

ifneq ($(X86_64_PARTS_ASM),)
   CORE_SOURCES_ASM += $(X86_64_PARTS_ASM)
   CORE_FLAGS += -DLIBRETRO_X86_64_PARTS
endif

# aarch64: the game's x86-64 code through FEXCore, in the emulator's own
# process, in place of box64
ifeq ($(ENABLE_FEX_GUEST_CPU),1)
ifneq ($(ARCH_ARM64),1)
$(error ENABLE_FEX_GUEST_CPU is for the aarch64 core)
endif
# FEX (externals/fex): the files of FEX-Emu/FEX f2b679f that FEXCore and the parts of
# its Source/Common the core uses are built from, with their headers. generated/ holds what
# FEX's CMake writes at configure time (the IR and config tables, the git hash).
FEX_DIR := $(EXT_DIR)/fex
FEX_BASE_DEFS := -DARCHITECTURE_arm64=1 -DFEX_DISABLE_TELEMETRY=1 -DFEX_HAS_PRESERVE_ALL_ATTR=1 \
	'-DFEX_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' -DHAS_PROGRAM_INVOCATION_NAME=1 \
	-D_LARGEFILE64_SOURCE
FEX_DEFS := $(FEX_BASE_DEFS) -DFEXCORE_HAS_PRESERVE_ALL_ATTR=1 \
	'-DFEXCORE_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' \
	'-DGLOBAL_DATA_DIRECTORY="/usr/local/share/fex-emu/"' -DHAS_SYSCALL_GETCPU=1 \
	-DHAS_SYSCALL_GETTID=1 -DHAS_SYSCALL_RENAMEAT2=1 -DHAS_SYSCALL_STATX=1 \
	-DHAS_SYSCALL_TGKILL=1
# SoftFloat's own: its INLINE would replace libretro-common's, so only the code that includes
# SoftFloat's internals takes it
FEX_SF_DEFS := '-DINLINE=static inline' -DINLINE_LEVEL=4 -DSOFTFLOAT_BUILTIN_CLZ=1 \
	-DSOFTFLOAT_FAST_DIV32TO16=1 -DSOFTFLOAT_FAST_DIV64TO32=1 -DSOFTFLOAT_FAST_INT64=1
FEX_SF_INC := -I$(FEX_DIR)/External/SoftFloat-3e/include \
	-I$(FEX_DIR)/External/SoftFloat-3e/include/SoftFloat-3e
FEX_INC := -I$(FEX_DIR)/generated -I$(FEX_DIR)/generated/include -I$(FEX_DIR)/Source \
	-I$(FEX_DIR)/FEXCore/include -I$(FEX_DIR)/External/unordered_dense/include \
	-I$(FEX_DIR)/FEXHeaderUtils -I$(FEX_DIR)/CodeEmitter -I$(FEX_DIR)/External/cephes/include \
	$(FEX_SF_INC)
# A log format that does not match its arguments fails the build, as in the core
FEX_CXX := -std=gnu++20 -fomit-frame-pointer -Wno-trigraphs -Wno-deprecated-enum-enum-conversion \
	-Werror=format
# FEXCore
FEXCORE_SOURCES_CXX := $(addprefix $(FEX_DIR)/FEXCore/Source/,Common/JitSymbols.cpp \
	Interface/Config/Config.cpp Interface/Context/Context.cpp Interface/GDBJIT/GDBJIT.cpp \
	$(addprefix Interface/Core/,Addressing.cpp ArchHelpers/Arm64Emitter.cpp CPUBackend.cpp \
	CPUID.cpp CodeCache.cpp Core.cpp Dispatcher/Dispatcher.cpp Frontend.cpp \
	Interpreter/Fallbacks/StringCompareFallbacks.cpp LookupCache.cpp OpcodeDispatcher.cpp) \
	$(addprefix Interface/Core/JIT/,ALUOps.cpp Arm64Relocations.cpp AtomicOps.cpp \
	BranchOps.cpp ConversionOps.cpp EncryptionOps.cpp JIT.cpp MemoryOps.cpp MiscOps.cpp \
	MoveOps.cpp VectorOps.cpp) \
	$(addprefix Interface/Core/OpcodeDispatcher/,AVX_128.cpp Crypto.cpp Flags.cpp Vector.cpp \
	X87.cpp X87F64.cpp) \
	$(addprefix Interface/Core/X86Tables/,BaseTables.cpp DDDTables.cpp H0F38Tables.cpp \
	H0F3ATables.cpp PrimaryGroupTables.cpp SecondaryGroupTables.cpp \
	SecondaryModRMTables.cpp SecondaryTables.cpp VEXTables.cpp X87Tables.cpp) \
	$(addprefix Interface/IR/,IRDumper.cpp IREmitter.cpp PassManager.cpp \
	Passes/IRDumperPass.cpp Passes/IRValidation.cpp \
	Passes/RedundantFlagCalculationElimination.cpp Passes/RegisterAllocationPass.cpp \
	Passes/x87StackOptimizationPass.cpp) \
	$(addprefix Utils/,Allocator.cpp Allocator/64BitAllocator.cpp ArchHelpers/Arm64.cpp \
	FileLoading.cpp ForcedAssert.cpp LogManager.cpp LongJump.cpp Profiler.cpp \
	SpinWaitLock.cpp Telemetry.cpp Threads.cpp WildcardMatcher.cpp))
FEXCORE_FLAGS := $(FEX_DEFS) -DJIT_ARM64 -I$(FEX_DIR)/FEXCore/Source -I$(LRC_DIR)/include \
	-I$(FEX_DIR)/FEXCore/Source/IncludePrivate $(FEX_INC)
FEXCORE_CXXFLAGS := $(FEX_CXX) -fvisibility-inlines-hidden -fno-strict-aliasing \
	-fno-exceptions -Werror=cast-qual -Werror=ignored-qualifiers -Werror=implicit-fallthrough \
	-ffunction-sections -fwrapv
# The x87 fallbacks, which include SoftFloat's internals
FEXCORESF_SOURCES_CXX := $(FEX_DIR)/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/InterpreterFallbacks.cpp
FEXCORESF_FLAGS := $(FEXCORE_FLAGS) $(FEX_SF_DEFS)
FEXCORESF_CXXFLAGS := $(FEXCORE_CXXFLAGS)
# FEX's allocator hooks: the C library's malloc, as for the rest of the core
FEXALLOC_SOURCES_CXX := $(FEX_DIR)/FEXCore/Source/Utils/AllocatorHooks.cpp
FEXALLOC_FLAGS := $(FEX_BASE_DEFS) '-DGLOBAL_DATA_DIRECTORY="/usr/local/share/fex-emu/"' \
	-I$(FEX_DIR)/FEXCore/Source -I$(FEX_DIR)/Source -I$(FEX_DIR)/generated \
	-I$(FEX_DIR)/FEXCore/include
FEXALLOC_CXXFLAGS := $(FEX_CXX) -fno-strict-aliasing -fno-exceptions
# FEX's Source/Common: the config and host feature code the core reaches
FEXCOMMON_SOURCES_CXX := $(addprefix $(FEX_DIR)/Source/Common/,CPUInfo.cpp Config.cpp \
	HostFeatures.cpp)
FEXCOMMON_FLAGS := $(FEX_DEFS) $(FEX_INC) -I$(FEX_DIR)/Source/Common -I$(LRC_DIR)/include
FEXCOMMON_CXXFLAGS := $(FEX_CXX)
# SoftFloat 3e and cephes: x87's 80-bit float and its transcendentals
FEXFLOAT_SOURCES_C := $(addprefix $(FEX_DIR)/External/SoftFloat-3e/src/,$(addsuffix .c, \
	$(addprefix extF80_,add div eq le lt mul rem roundToInt sqrt sub to_f128 to_f32 to_f64 \
	to_i32 to_i64 to_ui64) \
	$(addprefix f128_,add div eq eq_signaling isSignalingNaN le le_quiet lt lt_quiet mul \
	mulAdd rem sqrt sub to_extF80 to_f16 to_f32 to_f64 to_i32 to_i64 to_ui32 to_ui64) \
	f32_to_extF80 f32_to_f128 f64_to_extF80 i32_to_extF80 i32_to_f128 ui64_to_extF80 \
	softfloat_raiseFlags \
	$(addprefix s_,addMagsExtF80 addMagsF128 approxRecipSqrt32_1 approxRecipSqrt_1Ks \
	approxRecip_1Ks commonNaNToExtF80UI commonNaNToF128UI commonNaNToF32UI commonNaNToF64UI \
	extF80UIToCommonNaN f128UIToCommonNaN f32UIToCommonNaN f64UIToCommonNaN \
	normRoundPackToExtF80 normRoundPackToF128 normSubnormalExtF80Sig normSubnormalF128Sig \
	normSubnormalF32Sig normSubnormalF64Sig propagateNaNExtF80UI propagateNaNF128UI \
	roundPackToExtF80 roundPackToF128 roundPackToF32 roundPackToF64 roundToI32 roundToI64 \
	roundToUI64 shiftRightJam128 shiftRightJam128Extra subMagsExtF80 subMagsF128)))
FEXFLOAT_SOURCES_C += $(addprefix $(FEX_DIR)/External/cephes/src/128bit/,atanll.c constll.c \
	exp2ll.c floorll.c log2ll.c mtherr.c polevll.c sinll.c tanll.c)
FEXFLOAT_SOURCES_CXX := $(FEX_DIR)/External/cephes/src/128bit/Impl.cpp
FEXFLOAT_FLAGS := $(FEX_DEFS) $(FEX_SF_DEFS) -I$(FEX_DIR)/External/SoftFloat-3e -I$(FEX_DIR)/Source \
	-I$(FEX_DIR)/External/cephes/include $(FEX_SF_INC) -Wno-trigraphs -fno-builtin
FEXFLOAT_CXXFLAGS := $(FEX_CXX)
# Linked from one archive, so only what the core reaches comes in, as from FEX's own
FEX_GROUPS := FEXCORE FEXCORESF FEXALLOC FEXCOMMON FEXFLOAT
# libSceFiber HLE, its switches done on the guest's registers (no fiber_context.cpp asm)
CORE_SOURCES_CXX += src/core/libraries/fiber/fiber.cpp src/core/fex/fex_guest_engine.cpp \
	$(addprefix src/core/guest_cpu/,fex_guest_cpu.cpp fex_hle_bridge.cpp guest_cpu.cpp \
	hle_call_adapter.cpp)
# The core's own FEX code takes only FEX's attribute defines
CORE_FLAGS += -DSHADPS4_ENABLE_FEX_GUEST_CPU=1 -DFEX_DISABLE_TELEMETRY=1 -DFEX_HAS_PRESERVE_ALL_ATTR=1 \
	'-DFEX_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' -DFEXCORE_HAS_PRESERVE_ALL_ATTR=1 \
	'-DFEXCORE_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' \
	$(FEX_INC)
endif

# ----------------------------------------------------------------------------
# libretro-common
# ----------------------------------------------------------------------------
LRC_SOURCES_C :=
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/compat/,compat_posix_string.c fopen_utf8.c \
	compat_strcasestr.c compat_strl.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/crypto/,crypto.c kdf.c pk.c x509.c)
LRC_SOURCES_C += $(LRC_DIR)/dynamic/dylib.c
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/encodings/,encoding_base64.c \
	encoding_crc32.c encoding_deflate.c encoding_rzstd.c encoding_utf.c encoding_xxh3.c \
	encoding_xxh64.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/features/,features_cpu.c)
LRC_SOURCES_C += $(LRC_DIR)/memmap/memmap.c
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/file/,file_path.c file_path_io.c retro_dirent.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/aac/,raac.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/atrac9/,ratrac9.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/flac/,rflac.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/h264/,rh264.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/h265/,rh265.c rh265_sps_crop.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/jpeg/,rjpeg.c rjpeg_encode.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/json/,rjson.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/mp3/,rmp3.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/mp4/,rmp4.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/png/,rpng.c rpng_encode.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/xml/,rxml.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/zar/,zar.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/gfx/font/,rtt.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/hash/,lrc_hash.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/lists/,string_list.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/net/,net_compat.c net_http.c net_socket.c \
	net_socket_ssl_retro.c net_upnp.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/queues/,retro_spsc.c retro_waitable_spsc.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/rthreads/,retro_eventcount.c retro_shared_eventcount.c \
	rthreads.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/streams/,file_stream.c interface_stream.c \
	memory_stream.c trans_stream.c trans_stream_deflate.c trans_stream_pipe.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/string/,rstrtod.c stdstring.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/time/,rtime.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/utils/,md5.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/vfs/,vfs_implementation.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/vulkan/,vulkan_symbol_wrapper.c)

LRC_FLAGS := -I$(LRC_DIR)/include
# The Vulkan loader, loaded at run time (vk_platform.cpp)
$(OBJ_DIR)/$(LRC_DIR)/dynamic/dylib.c.o: CFLAGS += -DHAVE_DYNAMIC
$(OBJ_DIR)/src/video_core/renderer_vulkan/vk_platform.cpp.o: CXXFLAGS += -DHAVE_DYNAMIC
# The Vulkan symbol wrapper, against the core's own Vulkan headers
$(OBJ_DIR)/$(LRC_DIR)/vulkan/vulkan_symbol_wrapper.c.o: CFLAGS += -isystem $(EXT_DIR)/vulkan-headers/include
# HTTPS through libretro-common's own TLS client
$(OBJ_DIR)/$(LRC_DIR)/net/net_http.c.o: CFLAGS += -DHAVE_SSL -DHAVE_RETROSSL
# Zstandard-compressed blocks in ZArchive
$(OBJ_DIR)/$(LRC_DIR)/formats/zar/zar.c.o: CFLAGS += -DHAVE_RZSTD

# ----------------------------------------------------------------------------
# Libraries
# ----------------------------------------------------------------------------


LIBUSB_DIR := $(EXT_DIR)/libusb/libusb
LIBUSB_SOURCES_C := $(addprefix $(LIBUSB_DIR)/,core.c descriptor.c hotplug.c io.c strerror.c \
	sync.c)
ifeq ($(OS_LINUX),1)
   LIBUSB_SOURCES_C += $(addprefix $(LIBUSB_DIR)/os/,linux_usbfs.c linux_netlink.c \
	events_posix.c threads_posix.c)
endif
ifeq ($(OS_WIN),1)
   LIBUSB_SOURCES_C += $(addprefix $(LIBUSB_DIR)/os/,threads_windows.c windows_common.c \
	windows_usbdk.c windows_winusb.c events_windows.c)
endif
LIBUSB_FLAGS := -Ilibretro/libusb-config -I$(LIBUSB_DIR) -I$(LIBUSB_DIR)/os -w
# libusb's Windows backend uses windows.h's min and max
LIBUSB_FLAGS += -UNOMINMAX

LIB_GROUPS := CORE LRC LIBUSB
