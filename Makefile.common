# Source lists and per-library flags for the static Makefile build of the
# shadps4 libretro core. Included by Makefile, which sets the platform
# switches used here:
#
#   ARCH_X86_64 / ARCH_ARM64     target architecture
#   OS_LINUX / OS_WIN            target OS
#
# and takes these options:
#
#   LIBRETRO_X86_64_PARTS=<dir>  aarch64: carry box64 and the x86-64 build
#                                (box64, shadps4_libretro_host, shadps4_libretro.so)
#   ENABLE_FEX_GUEST_CPU=1       aarch64: run the game's code through FEXCore, with
#   FEXCORE_GUEST_CPU_SOURCE_DIR=<dir> FEXCORE_GUEST_CPU_BUILD_DIR=<dir>
#                                FEX built on its own (.ci/build-fex.sh)
#
# The lists follow CMakeLists.txt: a source added there is added here too.

LRC_DIR := libretro/libretro-common
EXT_DIR := externals

# ----------------------------------------------------------------------------
# Generated files
# ----------------------------------------------------------------------------
# Written aside and moved in place only when they change, so a build with
# nothing new compiles nothing.
replace_if_changed = cmp -s $(1).tmp $(1) || mv -f $(1).tmp $(1); rm -f $(1).tmp

# Version and git information (src/common/scm_rev.cpp.in), as CMakeLists.txt
# fills them in; the date is the commit's, so the same commit builds the same.
APP_VERSION     := 0.20.1 WIP
GIT_REV         := $(shell git rev-parse HEAD 2>/dev/null)
GIT_DESC        := $(shell git describe --always --long --dirty 2>/dev/null)
GIT_BRANCH      := $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null)
GIT_REMOTE_NAME := $(firstword $(subst /, ,$(shell git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)))
ifeq ($(GIT_REMOTE_NAME),)
   GIT_REMOTE_NAME := $(shell git config --get remote.pushDefault 2>/dev/null)
endif
ifeq ($(GIT_REMOTE_NAME),)
   GIT_REMOTE_NAME := origin
endif
GIT_REMOTE_URL  := $(shell git config --get remote.$(GIT_REMOTE_NAME).url 2>/dev/null)
BUILD_DATE      := $(shell git log -1 --format=%cd --date=format:'%Y-%m-%d %H:%M:%S' 2>/dev/null)

SCM_REV_CPP := $(GEN_DIR)/scm_rev.cpp
SCM_REV_STATUS := $(shell mkdir -p $(GEN_DIR); sed \
	-e 's|@APP_VERSION@|$(APP_VERSION)|' -e 's|@APP_IS_RELEASE@|false|' \
	-e 's|@GIT_REV@|$(GIT_REV)|' -e 's|@GIT_BRANCH@|$(GIT_BRANCH)|' \
	-e 's|@GIT_DESC@|$(GIT_DESC)|' -e 's|@GIT_REMOTE_NAME@|$(GIT_REMOTE_NAME)|' \
	-e 's|@GIT_REMOTE_URL@|$(GIT_REMOTE_URL)|' -e 's|@BUILD_DATE@|$(BUILD_DATE)|' \
	src/common/scm_rev.cpp.in > $(SCM_REV_CPP).tmp; $(call replace_if_changed,$(SCM_REV_CPP)))

# The files the core carries (src/common/embedded_resources.h)
EMBEDDED_RESOURCES := $(addprefix src/resources/,big_picture/controller.png \
	big_picture/profiles.png big_picture/settings.png bronze.png gold.png platinum.png \
	shadps4.png silver.png trophy.wav amd_rcp_index_table.bin.zstd \
	amd_rsqrt_index_table.bin.zstd)
EMBEDDED_RESOURCES_C := $(GEN_DIR)/embedded_resources.c
$(EMBEDDED_RESOURCES_C): $(EMBEDDED_RESOURCES) libretro/embed.sh
	@mkdir -p $(@D)
	sh libretro/embed.sh resources $@ . $(EMBEDDED_RESOURCES)

# The ImGui fonts, packed by ImGui's own tool built for the build machine
# (src/imgui/renderer/CMakeLists.txt); font_data.cpp includes them.
FONT_TOOL := $(GEN_DIR)/binary_to_compressed_c$(HOST_EXE)
$(FONT_TOOL): $(EXT_DIR)/imgui/misc/fonts/binary_to_compressed_c.cpp
	@mkdir -p $(@D)
	$(HOSTCXX) -O2 $< -o $@

FONTS_DIR := $(GEN_DIR)/fonts
FONTS :=
# $(1) the font, $(2) the name it is generated under
define FONT_template
$(FONTS_DIR)/imgui_fonts/$(2).g.cpp: src/imgui/renderer/fonts/$(1) $(FONT_TOOL)
	@mkdir -p $$(@D)
	$(FONT_TOOL) -nostatic $$< imgui_font_$(basename $(2)) > $$@.tmp
	mv -f $$@.tmp $$@
FONTS += $(FONTS_DIR)/imgui_fonts/$(2).g.cpp
endef
$(eval $(call FONT_template,NotoSans-Regular.ttf,notosans_regular.ttf))
$(eval $(call FONT_template,NotoSansArabic-Regular.ttf,notosansarabic_regular.ttf))
$(eval $(call FONT_template,NotoSansCJK-Regular.ttc,notosanscjk_regular.ttc))
$(eval $(call FONT_template,NotoSansSymbols2-Regular.ttf,notosanssymbols2_regular.ttf))
$(eval $(call FONT_template,NotoSansThai-Regular.ttf,notosansthai_regular.ttf))
$(eval $(call FONT_template,ProggyVector-Regular.ttf,proggyvector_regular.ttf))
$(OBJ_DIR)/src/imgui/renderer/font_data.cpp.o: $(FONTS)

# Linux: the launcher of the emulator's process (libretro/host_main.c), built
# for the target and carried in the core as an array.
ifeq ($(OS_LINUX),1)
LIBRETRO_HOST      := $(OBJ_DIR)/gen/shadps4_libretro_host
LIBRETRO_HOST_BLOB := $(OBJ_DIR)/gen/libretro_host_blob.c
$(LIBRETRO_HOST): libretro/host_main.c
	@mkdir -p $(@D)
	$(CC) $(filter-out -fPIC -fvisibility=hidden,$(CFLAGS)) -fPIE -pie -Isrc -MMD -MP $< -o $@ -ldl
$(LIBRETRO_HOST_BLOB): $(LIBRETRO_HOST) libretro/embed.sh
	sh libretro/embed.sh host $@ $<
-include $(LIBRETRO_HOST).d
endif

# aarch64: box64 and the x86-64 build, carried in the core, which writes them
# into the frontend's system directory and starts its emulator process through
# them (libretro_core.cpp).
ifneq ($(LIBRETRO_X86_64_PARTS),)
ifneq ($(ARCH_ARM64),1)
$(error LIBRETRO_X86_64_PARTS is for the aarch64 core)
endif
X86_64_PARTS := box64 shadps4_libretro_host shadps4_libretro.so
X86_64_PARTS_FILES := $(addprefix $(LIBRETRO_X86_64_PARTS)/,$(X86_64_PARTS))
$(foreach f,$(X86_64_PARTS_FILES),$(if $(wildcard $(f)),,$(error $(f) is missing)))
X86_64_PARTS_ASM := $(GEN_DIR)/libretro_x86_64_parts.S
X86_64_PARTS_STATUS := $(shell mkdir -p $(GEN_DIR); { \
	echo '.section .rodata'; \
	for part in $(X86_64_PARTS); do \
		symbol=g_part_`echo $$part | tr -c 'A-Za-z0-9_\n' '_'`; \
		echo '.balign 16'; \
		echo ".globl $$symbol"; echo ".hidden $$symbol"; echo "$$symbol:"; \
		echo ".incbin \"$(LIBRETRO_X86_64_PARTS)/$$part\""; \
		echo ".globl $${symbol}_end"; echo ".hidden $${symbol}_end"; echo "$${symbol}_end:"; \
	done; \
	echo '.section .note.GNU-stack,"",%progbits'; \
	} > $(X86_64_PARTS_ASM).tmp; $(call replace_if_changed,$(X86_64_PARTS_ASM)))
$(OBJ_DIR)/$(X86_64_PARTS_ASM).o: $(X86_64_PARTS_FILES)
endif

