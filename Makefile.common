CORE_FLAGS := -DIMGUI_USER_CONFIG='"imgui/imgui_config.h"' -DZYCORE_STATIC_BUILD \
	-DZYDIS_STATIC_BUILD -Isrc -I$(LRC_DIR)/include -I. -I$(FONTS_DIR) \
	-isystem $(EXT_DIR)/fmt/include -isystem $(EXT_DIR)/xbyak -isystem $(EXT_DIR)/imgui \
	-isystem $(EXT_DIR)/gcn/include -isystem $(EXT_DIR)/vma/include \
	-isystem $(EXT_DIR)/sirit/include -isystem $(EXT_DIR)/sirit/externals/SPIRV-Headers/include \
	-isystem $(EXT_DIR)/vulkan-headers/include -isystem $(EXT_DIR)/zydis/include \
	-isystem $(EXT_DIR)/zydis/dependencies/zycore/include -isystem $(EXT_DIR)/libusb/libusb
CORE_CXXFLAGS := -Wno-invalid-offsetof

ifneq ($(X86_64_PARTS_ASM),)
   CORE_SOURCES_ASM += $(X86_64_PARTS_ASM)
   CORE_FLAGS += -DLIBRETRO_X86_64_PARTS
endif

# aarch64: the game's x86-64 code through FEXCore, in the emulator's own
# process, in place of box64
ifeq ($(ENABLE_FEX_GUEST_CPU),1)
ifneq ($(ARCH_ARM64),1)
$(error ENABLE_FEX_GUEST_CPU is for the aarch64 core)
endif
FEX_SRC   := $(FEXCORE_GUEST_CPU_SOURCE_DIR)
FEX_BUILD := $(FEXCORE_GUEST_CPU_BUILD_DIR)
ifeq ($(FEX_SRC)$(FEX_BUILD),)
$(error ENABLE_FEX_GUEST_CPU needs FEXCORE_GUEST_CPU_SOURCE_DIR and FEXCORE_GUEST_CPU_BUILD_DIR)
endif
# libSceFiber HLE, its switches done on the guest's registers (no fiber_context.cpp asm)
CORE_SOURCES_CXX += src/core/libraries/fiber/fiber.cpp src/core/fex/fex_guest_engine.cpp \
	$(addprefix src/core/guest_cpu/,fex_guest_cpu.cpp fex_hle_bridge.cpp guest_cpu.cpp \
	hle_call_adapter.cpp)
CORE_FLAGS += -DSHADPS4_ENABLE_FEX_GUEST_CPU=1 -DFEXCORE_HAS_PRESERVE_ALL_ATTR=1 \
	-DFEX_DISABLE_TELEMETRY=1 -DFEX_HAS_PRESERVE_ALL_ATTR=1 \
	'-DFEXCORE_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' \
	'-DFEX_PRESERVE_ALL_ATTR=__attribute__((preserve_all))' \
	-I$(FEX_BUILD) -I$(FEX_SRC) -I$(FEX_SRC)/Source -I$(FEX_BUILD)/Source \
	-I$(FEX_BUILD)/generated -I$(FEX_SRC)/Source/Tools/CommonTools \
	-I$(FEX_BUILD)/FEXCore/Source -I$(FEX_SRC)/FEXCore/include -I$(FEX_BUILD)/include \
	-I$(FEX_SRC)/External/unordered_dense/include -I$(FEX_SRC)/External/fmt/include \
	-I$(FEX_SRC)/External/xxhash -I$(FEX_SRC)/FEXHeaderUtils -I$(FEX_SRC)/CodeEmitter \
	-I$(FEX_SRC)/External/cephes/include -I$(FEX_SRC)/External/SoftFloat-3e/include \
	-I$(FEX_SRC)/External/SoftFloat-3e/include/SoftFloat-3e \
	-I$(FEX_SRC)/Source/Common/cpp-optparse -I$(FEX_SRC)/External/tiny-json \
	-I$(FEX_SRC)/External/range-v3/include -I$(FEX_SRC)/External/rpmalloc
FEX_LIBRARIES := $(addprefix $(FEX_BUILD)/,FEXCore/Source/libFEXCore.a \
	Source/Common/libCommon.a Source/Tools/CommonTools/libCommonTools.a \
	FEXCore/Source/libJemallocLibs.a Source/Common/cpp-optparse/libcpp-optparse.a \
	External/tiny-json/libtiny-json.a FEXCore/Source/libFEXCore_Base.a \
	External/fmt/libfmt.a External/xxhash/cmake_unofficial/libxxhash.a \
	External/cephes/libcephes_128bit.a External/SoftFloat-3e/libsoftfloat_3e.a \
	External/rpmalloc/librpmalloc.a)
$(foreach f,$(FEX_LIBRARIES),$(if $(wildcard $(f)),,$(error FEXCore guest CPU library is missing: $(f). Build FEX with .ci/build-fex.sh first.)))
LIBS := $(FEX_LIBRARIES) $(LIBS)
endif

# ----------------------------------------------------------------------------
# libretro-common
# ----------------------------------------------------------------------------
LRC_SOURCES_C :=
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/compat/,compat_posix_string.c fopen_utf8.c \
	compat_strcasestr.c compat_strl.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/crypto/,crypto.c kdf.c pk.c x509.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/encodings/,encoding_base64.c \
	encoding_crc32.c encoding_deflate.c encoding_rzstd.c encoding_utf.c encoding_xxh3.c \
	encoding_xxh64.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/features/,features_cpu.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/file/,file_path.c file_path_io.c retro_dirent.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/aac/,raac.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/atrac9/,ratrac9.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/flac/,rflac.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/h264/,rh264.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/h265/,rh265.c rh265_sps_crop.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/json/,rjson.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/mp3/,rmp3.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/mp4/,rmp4.c rmp4_audio.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/png/,rpng.c rpng_encode.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/xml/,rxml.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/formats/zar/,zar.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/gfx/font/,rtt.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/hash/,lrc_hash.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/lists/,string_list.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/net/,net_compat.c net_http.c net_socket.c \
	net_socket_ssl_retro.c net_upnp.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/queues/,retro_spsc.c retro_waitable_spsc.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/rthreads/,retro_eventcount.c retro_shared_eventcount.c \
	rthreads.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/streams/,file_stream.c interface_stream.c \
	memory_stream.c trans_stream.c trans_stream_deflate.c trans_stream_pipe.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/string/,rstrtod.c stdstring.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/time/,rtime.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/utils/,md5.c)
LRC_SOURCES_C += $(addprefix $(LRC_DIR)/vfs/,vfs_implementation.c)

LRC_FLAGS := -I$(LRC_DIR)/include
# HTTPS through libretro-common's own TLS client
$(OBJ_DIR)/$(LRC_DIR)/net/net_http.c.o: CFLAGS += -DHAVE_SSL -DHAVE_RETROSSL
# AAC in MP4/M4A, for the music player
$(OBJ_DIR)/$(LRC_DIR)/formats/mp4/rmp4_audio.c.o: CFLAGS += -DHAVE_RAAC
# Zstandard-compressed blocks in ZArchive
$(OBJ_DIR)/$(LRC_DIR)/formats/zar/zar.c.o: CFLAGS += -DHAVE_RZSTD

# ----------------------------------------------------------------------------
# Libraries
# ----------------------------------------------------------------------------
FMT_SOURCES_CXX := $(addprefix $(EXT_DIR)/fmt/src/,format.cc os.cc)
FMT_FLAGS := -I$(EXT_DIR)/fmt/include

IMGUI_SOURCES_CXX := $(addprefix $(EXT_DIR)/imgui/,imgui.cpp imgui_demo.cpp imgui_draw.cpp \
	imgui_tables.cpp imgui_widgets.cpp)
IMGUI_FLAGS := -DIMGUI_USER_CONFIG='"src/imgui/imgui_config.h"' -I. -I$(EXT_DIR)/imgui

SIRIT_SOURCES_CXX := $(EXT_DIR)/sirit/src/sirit.cpp \
	$(addprefix $(EXT_DIR)/sirit/src/instructions/,annotation.cpp arithmetic.cpp atomic.cpp \
	barrier.cpp bit.cpp constant.cpp conversion.cpp debug.cpp derivatives.cpp extension.cpp \
	flow.cpp function.cpp group.cpp image.cpp logical.cpp memory.cpp misc.cpp type.cpp)
SIRIT_FLAGS := -I$(EXT_DIR)/sirit/include -I$(EXT_DIR)/sirit/src \
	-isystem $(EXT_DIR)/sirit/externals/SPIRV-Headers/include
SIRIT_CXXFLAGS := -std=c++20

ZYDIS_DIR := $(EXT_DIR)/zydis
ZYCORE_DIR := $(ZYDIS_DIR)/dependencies/zycore
ZYDIS_SOURCES_C := $(addprefix $(ZYDIS_DIR)/src/,Decoder.c DecoderData.c Disassembler.c \
	Encoder.c EncoderData.c Formatter.c FormatterATT.c FormatterBase.c FormatterBuffer.c \
	FormatterIntel.c MetaInfo.c Mnemonic.c Register.c Segment.c SharedData.c String.c \
	Utils.c Zydis.c)
ZYDIS_FLAGS := -DZYCORE_STATIC_BUILD -DZYDIS_STATIC_BUILD -I$(ZYDIS_DIR)/include \
	-I$(ZYDIS_DIR)/src -I$(ZYCORE_DIR)/include
ZYCORE_SOURCES_C := $(addprefix $(ZYCORE_DIR)/src/,Allocator.c ArgParse.c Bitset.c Format.c \
	List.c String.c Vector.c Zycore.c) \
	$(addprefix $(ZYCORE_DIR)/src/API/,Memory.c Process.c Synchronization.c Terminal.c \
	Thread.c)
ZYCORE_FLAGS := -DZYCORE_STATIC_BUILD -D_GNU_SOURCE -I$(ZYCORE_DIR)/include -I$(ZYCORE_DIR)/src

LIBUSB_DIR := $(EXT_DIR)/libusb/libusb
LIBUSB_SOURCES_C := $(addprefix $(LIBUSB_DIR)/,core.c descriptor.c hotplug.c io.c strerror.c \
	sync.c)
ifeq ($(OS_LINUX),1)
   LIBUSB_SOURCES_C += $(addprefix $(LIBUSB_DIR)/os/,linux_usbfs.c linux_netlink.c \
	events_posix.c threads_posix.c)
endif
ifeq ($(OS_WIN),1)
   LIBUSB_SOURCES_C += $(addprefix $(LIBUSB_DIR)/os/,threads_windows.c windows_common.c \
	windows_usbdk.c windows_winusb.c events_windows.c)
endif
LIBUSB_FLAGS := -Ilibretro/libusb-config -I$(LIBUSB_DIR) -I$(LIBUSB_DIR)/os -w
# libusb's Windows backend uses windows.h's min and max
LIBUSB_FLAGS += -UNOMINMAX

LIB_GROUPS := CORE LRC FMT IMGUI SIRIT ZYDIS ZYCORE LIBUSB
