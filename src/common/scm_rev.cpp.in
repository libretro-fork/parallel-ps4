#include <string.h>

#include <compat/strl.h>

#include "common/scm_rev.h"

namespace Common {

constexpr char g_version[]  = "@APP_VERSION@";
constexpr bool g_is_release = @APP_IS_RELEASE@;

constexpr char g_scm_rev[]         = "@GIT_REV@";
constexpr char g_scm_branch[]      = "@GIT_BRANCH@";
constexpr char g_scm_desc[]        = "@GIT_DESC@";
constexpr char g_scm_remote_name[] = "@GIT_REMOTE_NAME@";
constexpr char g_scm_remote_url[]  = "@GIT_REMOTE_URL@";
constexpr char g_scm_date[]        = "@BUILD_DATE@";

void GetRemoteNameFromLink(char* out, size_t size) {
    const char* url = g_scm_remote_url;
    size_t len = strlen(url);
    size_t start = 0;
    size_t count = 0;
    if (strncmp(url, "http", 4) == 0) {
        if (url[len - 1] == '/') {
            len--;
        }
        // After "https://github.com/", up to the last slash
        start = 19;
        if (start > len) {
            strlcpy(out, "unknown", size);
            return;
        }
        size_t slash = len;
        while (slash > 0 && url[slash - 1] != '/') {
            slash--;
        }
        slash--; // "http" has a slash after it, so one is found
        count = (slash >= start) ? slash - start : len - start;
    } else if (strncmp(url, "git@", 4) == 0) {
        // Between the colon and the first slash
        const char* colon = static_cast<const char*>(memchr(url, ':', len));
        start = colon ? static_cast<size_t>(colon - url) + 1 : 0;
        const char* slash = static_cast<const char*>(memchr(url, '/', len));
        const size_t at = slash ? static_cast<size_t>(slash - url) : len;
        count = (slash && at >= start) ? at - start : len - start;
    } else {
        strlcpy(out, "unknown", size);
        return;
    }
    if (count > len - start) {
        count = len - start;
    }
    if (size == 0) {
        return;
    }
    if (count >= size) {
        count = size - 1;
    }
    memcpy(out, url + start, count);
    out[count] = '\0';
}

} // namespace

