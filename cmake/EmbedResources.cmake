# Writes the files the core carries (src/common/embedded_resources.h) into a C source:
#   cmake -DROOT=<source tree> -DOUTPUT=<.c file> -DFILES=<path;path;...> -P EmbedResources.cmake
# The paths are relative to ROOT and are the names the files are found by. The static
# Makefile does the same with libretro/embed.sh: keep the two in step.

set(text "/* Generated by cmake/EmbedResources.cmake. */\n")
string(APPEND text "struct EmbeddedResource {\n    const char *path;\n    const unsigned char *data;\n    unsigned long size;\n};\n")
set(table "")
set(index 0)
foreach (path IN LISTS FILES)
    file(READ "${ROOT}/${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND text "static const unsigned char resource_${index}[] = {${bytes}};\n")
    string(APPEND table "    {\"${path}\", resource_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND text "const struct EmbeddedResource g_embedded_resources[] = {\n${table}};\n")
string(APPEND text "const unsigned long g_embedded_resource_count = ${index};\n")
file(WRITE "${OUTPUT}" "${text}")
